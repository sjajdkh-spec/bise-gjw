# ==============================
# DISCORD BOT
# ==============================
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Prefix command
PREFIX=!

# ==============================
# MONGODB
# ==============================
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bise_result_bot

# ==============================
# DISCORD RESULT SETTINGS
# ==============================
RESULT_CHANNEL_ID=YOUR_RESULT_CHANNEL_ID
MENTION_ROLE_ID=YOUR_RESULT_ROLE_ID

# ==============================
# BISE GUJRANWALA
# ==============================
OFFICIAL_RESULT_URL=https://www.bisegrw.edu.pk/

# ==============================
# REQUEST SETTINGS
# ==============================
HTTP_TIMEOUT=20
PER_REQUEST_DELAY=2

# ==============================
# AUTOMATIC RESULT CHECKER
# ==============================
AUTO_CHECK_ENABLED=true
